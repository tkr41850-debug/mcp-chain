# Enforce LF line endings for files that the binary parses at runtime.
# The embedded EFF wordlist is split on "\n"; CRLF checkouts on Windows
# corrupt the parse with a trailing \r in each word.
*.txt text eol=lf
*.sh text eol=lf
*.go text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
